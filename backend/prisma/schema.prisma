datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum ContactStatus {
  UNREAD
  READ
  IN_PROGRESS
  REPLIED
  ARCHIVED
}

model User {
  id                   String      @id @default(cuid())
  email                String      @unique
  passwordHash         String
  name                 String
  role                 Role        @default(USER)
  avatar               String?
  isActive             Boolean     @default(true)
  refreshToken         String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  auditLogs            AuditLog[]

  @@map("users")
}

model ContactSubmission {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String
  message   String        @db.Text
  status    ContactStatus @default(UNREAD)
  notes     String?       @db.Text
  ipAddress String?
  userAgent String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@map("contact_submissions")
}

model Service {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  subtitle      String?
  heroHeadline  String
  description   String   @db.Text
  img           String
  whyTitle      String
  whyText       String   @db.Text
  benefitsImage String?
  features      Json     // Array of { title: string, desc: string }
  process       Json     // Array of { step: string, title: string, desc: string, color: string }
  faqs          Json     // Array of { title: string, content: string }
  order         Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([isActive, order])
  @@map("services")
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  content     String?   @db.Text
  category    String
  image       String
  authorName  String    @default("Scaleminte Team")
  isPublished Boolean   @default(true)
  publishedAt DateTime  @default(now())
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished, publishedAt])
  @@map("blog_posts")
}

model PortfolioProject {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  image       String
  clientName  String?
  projectUrl  String?
  description String?  @db.Text
  isFeatured  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isFeatured, order])
  @@map("portfolio_projects")
}

model PricingPackage {
  id          String   @id @default(cuid())
  name        String
  price       String
  description String   @db.Text
  isPopular   Boolean  @default(false)
  features    Json     // Array of string features
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
  @@map("pricing_packages")
}

model TeamMember {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  role         String
  img          String
  bio          String   @db.Text
  expertise    Json     // string[]
  tools        Json     // string[]
  experience   Json     // { title, company, period }[]
  education    Json     // { degree, institution, year }[]
  fiverrStatus String?
  fiverrLink   String?
  facebookUrl  String?
  linkedinUrl  String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([slug])
  @@index([isActive, order])
  @@map("team_members")
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String   @db.Text
  category  String   @default("general")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive, order])
  @@map("faqs")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}
