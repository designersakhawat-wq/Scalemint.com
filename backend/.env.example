# Scaleminte Backend Production Configuration
NODE_ENV=production
PORT=5000

# Allowed client domains (comma-separated or * for wildcard)
CLIENT_URL=http://localhost:3000,https://scaleminte.com,https://www.scaleminte.com

# PostgreSQL / MySQL / Database URL (Optional if using default file storage)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scaleminte_db?schema=public

# Security & JWT Tokens (Please change to random strong strings in production)
JWT_SECRET=your_super_strong_jwt_production_secret_key_change_me
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_super_strong_jwt_refresh_production_secret_key_change_me
JWT_REFRESH_EXPIRES_IN=7d

# SMTP Email Configuration (Optional for contact notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Scaleminte Support <no-reply@scaleminte.com>"
ADMIN_NOTIFICATION_EMAIL=admin@scaleminte.com

# File Upload Settings
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
